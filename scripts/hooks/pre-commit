#!/usr/bin/env bash
# Lint must pass cleanly before a commit: shellcheck with every optional check, shfmt.
set -euo pipefail
# Git exports its own environment to hooks; the checks below must see the working tree as a user would.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
top="$(git rev-parse --show-toplevel)"
cd "${top}"
make --no-print-directory lint
