#!/usr/bin/env bash
# git-locks — declare the paths you are about to write, as refs in the repo.
#
#   git locks [--text] claim   --job <id> --holder <name> [--ttl <seconds>] <path>...
#   git locks [--text] release --job <id>
#   git locks [--text] check   <path>...        exit 1 if any path is held
#   git locks [--text] list
#   git locks [--text] sweep                    delete expired locks
#   git locks [--text] store                    print the store this repository resolves to
#   git locks help | schema | version
#
# Output is JSON Lines by default: one object per result on stdout, written as
# each result is known, refusals as objects on stderr; every line conforms to
# schema/git-locks.schema.json, which `git locks schema` prints byte-for-byte.
# --text switches every command to human-readable lines.
#
# Where the locks live: NOT in the working repository by default. The store is
# a bare repository at $GIT_LOCKS_HOME/locks/<absolute path of the subject's main repo>
# ($GIT_LOCKS_HOME defaults to ~/.git-stunts), created on first use, so a
# project's own refs stay clean. Override with GIT_LOCKS_STORE=<path> or
# GIT_LOCKS_STORE=self (the subject's own common git dir, shared by its
# worktrees), or persistently with `git config locks.store <path|self>`.
# Precedence: environment, then config, then the default.
#
# A lock is one blob (a plain-text record: job, holder, claimed, expires, and
# the paths) pointed at by refs/locks/jobs/<id> and by refs/locks/paths/<h>
# for every path, where <h> is git's own hash of the path string. A claim is a
# single `git update-ref --stdin` transaction, so it is atomic across all of
# its paths and across racing claimants: `create` fails if another claimant
# got there first, and every replacement carries the old value it expects.
# Refs live outside the worktree, so nothing here ever shows as untracked.
#
# Exit codes: 0 done (or free), 1 refused / held, 2 usage or not a repository.
# GIT_LOCKS_NOW=<epoch seconds> fixes the clock (tests). Pure bash + git.
set -uo pipefail

NS='refs/locks'
DEFAULT_TTL=14400
SCHEMA='git-locks/1'
VERSION='0.1.0'
TEXT=0 # 1 after --text: human lines instead of JSONL

usage_text() {
  cat <<'EOF'
usage: git locks [--text] claim   --job <id> --holder <name> [--ttl <seconds>] <path>...
       git locks [--text] release --job <id>
       git locks [--text] check   <path>...
       git locks [--text] list
       git locks [--text] sweep
       git locks [--text] store
       git locks [--text] version
       git locks help | schema

claim    lock the paths for the job, atomically; re-claiming with the same job replaces its path set
release  drop the job's lock and every path ref that still points at it
check    who holds each path; exit 1 if any is held
list     every lock, live or expired, with its paths
sweep    delete expired locks
store    print the store this repository resolves to
schema   print the JSON Schema every output line conforms to

output:  JSON Lines on stdout by default, one object per result, written as
         each result is known; refusals are JSON Lines on stderr. --text
         switches every command to human-readable lines.
store:   GIT_LOCKS_STORE=<path|self>, else `git config locks.store`,
         else ${GIT_LOCKS_HOME:-~/.git-stunts}/locks/<main repo path>
clock:   GIT_LOCKS_NOW=<epoch seconds> (tests)
exit:    0 done or free, 1 refused or held, 2 usage or not a repository
EOF
}

usage() {
  usage_text >&2
  exit 2
}

sub_usage() { # subcommand -> its one-line usage on stdout
  case "$1" in
    claim) printf 'usage: git locks [--text] claim --job <id> --holder <name> [--ttl <seconds>] <path>...\n' ;;
    release) printf 'usage: git locks [--text] release --job <id>\n' ;;
    check) printf 'usage: git locks [--text] check <path>...\n' ;;
    list) printf 'usage: git locks [--text] list\n' ;;
    sweep) printf 'usage: git locks [--text] sweep\n' ;;
    store) printf 'usage: git locks [--text] store\n' ;;
    *) usage_text ;;
  esac
}

json_str() { # VAR VALUE: set VAR to VALUE escaped and quoted for JSON (paths and holders already refuse newlines)
  local s="$2"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  printf -v "$1" '"%s"' "${s}"
}

json_paths() { # VAR: set VAR to a JSON array of the lines on stdin
  local line items=() one IFS
  while IFS= read -r line; do
    if [[ -n "${line}" ]]; then
      json_str one "${line}"
      items+=("${one}")
    fi
  done
  IFS=','
  printf -v "$1" '[%s]' "${items[*]}"
}

fail() { # message [code]
  printf 'git-locks: %s\n' "$1" >&2
  exit "${2:-1}"
}

now() {
  if [[ -n "${GIT_LOCKS_NOW:-}" ]]; then
    printf '%s' "${GIT_LOCKS_NOW}"
  else
    date +%s
  fi
}

iso() { # epoch -> ISO-8601 UTC, portable across BSD and GNU date
  date -u -r "$1" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u -d "@$1" '+%Y-%m-%dT%H:%M:%SZ'
}

path_ref() {
  local h
  h="$(printf '%s' "$1" | g hash-object --stdin)" || return 1
  printf '%s/paths/%s' "${NS}" "${h}"
}

job_ref() { printf '%s/jobs/%s' "${NS}" "$1"; }

ref_oid() { g rev-parse -q --verify "$1^{blob}" 2>/dev/null || true; }

field() { # oid key
  g cat-file -p "$1" | sed -n "s/^$2: //p" | head -n 1
}

record_paths() { # oid -> paths, one per line
  g cat-file -p "$1" | sed -n '/^paths:$/,$p' | sed '1d'
}

job_refs() { g for-each-ref --format='%(refname) %(objectname)' "${NS}/jobs/"; }

valid_job() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }

normalize_path() { # -> prints the path, or returns 2 with the reason on stderr
  local p="$1"
  while [[ "${p}" == ./* ]]; do p="${p#./}"; done
  [[ -z "${p}" ]] && {
    printf 'git-locks: an empty path\n' >&2
    return 2
  }
  [[ "${p}" == /* ]] && {
    printf 'git-locks: %s: paths are repo-relative\n' "${p}" >&2
    return 2
  }
  [[ "${p}" == *$'\n'* ]] && {
    printf 'git-locks: a path with a newline is not supported\n' >&2
    return 2
  }
  local IFS='/' part
  for part in ${p}; do
    [[ "${part}" == '..' ]] && {
      printf 'git-locks: %s: no .. components\n' "${p}" >&2
      return 2
    }
  done
  printf '%s' "${p}"
}

require_repo() { git rev-parse --git-dir >/dev/null 2>&1 || fail 'not in a git repository' 2; }

STORE=''

resolve_store() { # sets STORE; creates the default or a custom store on first use
  local common sel
  common="$(git rev-parse --path-format=absolute --git-common-dir)" || fail 'cannot resolve the git dir' 2
  sel="${GIT_LOCKS_STORE:-}"
  if [[ -z "${sel}" ]]; then
    sel="$(git config --get locks.store 2>/dev/null)" || sel=''
  fi
  case "${sel}" in
    '') STORE="${GIT_LOCKS_HOME:-${HOME}/.git-stunts}/locks${common%/.git}" ;; # keyed on the main repo, so worktrees share
    self) STORE="${common}" ;;
    /*) STORE="${sel}" ;;
    *) STORE="${PWD}/${sel}" ;;
  esac
  if [[ "${STORE}" != "${common}" ]] && ! git --git-dir="${STORE}" rev-parse --git-dir >/dev/null 2>&1; then
    mkdir -p "${STORE}" || fail "cannot create the lock store at ${STORE}" 2
    git init -q --bare "${STORE}" || fail "cannot initialise the lock store at ${STORE}" 2
  fi
}

g() { git --git-dir="${STORE}" "$@"; }

transact() { # plan lines on stdin -> git update-ref transaction; stderr captured by the caller
  {
    printf 'start\n'
    cat
    printf 'prepare\ncommit\n'
  } | g update-ref --stdin
}

describe() { # oid -> "held by H (job J, until ISO)" pieces via globals D_HOLDER D_JOB D_UNTIL
  D_HOLDER="$(field "$1" holder)"
  D_JOB="$(field "$1" job)"
  local exp
  exp="$(field "$1" expires)"
  D_EXPIRES="${exp:-0}"
  D_UNTIL="$(iso "${D_EXPIRES}")"
}

in_list() { # needle list...
  local needle="$1" item
  shift
  for item in "$@"; do [[ "${item}" == "${needle}" ]] && return 0; done
  return 1
}

# ---------------------------------------------------------------- claim

cmd_claim() {
  local _j1 _j2 _j3
  local job='' holder='' ttl="${DEFAULT_TTL}" paths=() p
  while (($# > 0)); do
    case "$1" in
      --job)
        [[ $# -ge 2 ]] || usage
        job="$2"
        shift 2
        ;;
      --holder)
        [[ $# -ge 2 ]] || usage
        holder="$2"
        shift 2
        ;;
      --ttl)
        [[ $# -ge 2 ]] || usage
        ttl="$2"
        shift 2
        ;;
      --)
        shift
        paths+=("$@")
        break
        ;;
      -*) usage ;;
      *)
        paths+=("$1")
        shift
        ;;
    esac
  done
  [[ -n "${job}" && -n "${holder}" ]] || usage
  valid_job "${job}" || fail "job id '${job}' must match [A-Za-z0-9][A-Za-z0-9._-]*" 2
  [[ "${ttl}" =~ ^[0-9]+$ && "${ttl}" -gt 0 ]] || fail '--ttl is a positive number of seconds' 2
  [[ "${holder}" == *$'\n'* ]] && fail 'holder must be one line' 2
  ((${#paths[@]} > 0)) || usage

  local norm=() n
  for p in "${paths[@]}"; do
    n="$(normalize_path "${p}")" || exit 2
    norm+=("${n}")
  done
  local sorted wanted=()
  sorted="$(printf '%s\n' "${norm[@]}" | sort -u)"
  while IFS= read -r n; do [[ -n "${n}" ]] && wanted+=("${n}"); done <<<"${sorted}"

  local at expires
  at="$(now)"
  expires=$((at + ttl))

  # The record blob first: every planned ref points at it.
  local record new_oid
  record="$(
    printf 'schema: %s\njob: %s\nholder: %s\nclaimed: %s\nexpires: %s\npaths:\n' "${SCHEMA}" "${job}" "${holder}" "${at}" "${expires}"
    printf '%s\n' "${wanted[@]}"
  )"
  new_oid="$(printf '%s\n' "${record}" | g hash-object -w --stdin)" || fail 'could not write the lock record'

  local jref old_job_oid
  jref="$(job_ref "${job}")"
  old_job_oid="$(ref_oid "${jref}")"

  local plan=() conflicts=() evict_jobs=() evict_oids=() planned_refs=()
  local ref cur rjob rexp
  for p in "${wanted[@]}"; do
    ref="$(path_ref "${p}")"
    cur="$(ref_oid "${ref}")"
    if [[ -z "${cur}" ]]; then
      plan+=("create ${ref} ${new_oid}")
    else
      rjob="$(field "${cur}" job)"
      rexp="$(field "${cur}" expires)"
      if [[ "${rjob}" == "${job}" ]]; then
        plan+=("update ${ref} ${new_oid} ${cur}")
      elif [[ -n "${rexp}" && "${rexp}" -le "${at}" ]]; then
        plan+=("update ${ref} ${new_oid} ${cur}")
        evict_jobs+=("${rjob}")
        evict_oids+=("${cur}")
      else
        describe "${cur}"
        refusal "${p}"
        conflicts+=("${p}")
      fi
    fi
    planned_refs+=("${ref}")
  done
  ((${#conflicts[@]} > 0)) && exit 1

  # Paths this job held before and no longer lists are released in the same transaction.
  local old_paths have
  if [[ -n "${old_job_oid}" ]]; then
    plan+=("update ${jref} ${new_oid} ${old_job_oid}")
    old_paths="$(record_paths "${old_job_oid}")"
    while IFS= read -r p; do
      [[ -z "${p}" ]] && continue
      ref="$(path_ref "${p}")"
      in_list "${ref}" "${planned_refs[@]}" && continue
      have="$(ref_oid "${ref}")"
      [[ "${have}" == "${old_job_oid}" ]] && plan+=("delete ${ref} ${old_job_oid}")
    done <<<"${old_paths}"
  else
    plan+=("create ${jref} ${new_oid}")
  fi

  # An expired lock in the way is evicted whole: its job ref and its other path refs.
  local i ej eo ejref
  for i in "${!evict_jobs[@]}"; do
    ej="${evict_jobs[${i}]}"
    eo="${evict_oids[${i}]}"
    ejref="$(job_ref "${ej}")"
    have="$(ref_oid "${ejref}")"
    [[ "${have}" == "${eo}" ]] && plan+=("delete ${ejref} ${eo}")
    old_paths="$(record_paths "${eo}")"
    while IFS= read -r p; do
      [[ -z "${p}" ]] && continue
      ref="$(path_ref "${p}")"
      in_list "${ref}" "${planned_refs[@]}" && continue
      have="$(ref_oid "${ref}")"
      if [[ "${have}" == "${eo}" ]]; then
        plan+=("delete ${ref} ${eo}")
        planned_refs+=("${ref}")
      fi
    done <<<"${old_paths}"
  done

  local err
  if ! err="$(printf '%s\n' "${plan[@]}" | transact 2>&1)"; then
    # Lost a race between the read above and the transaction: say who won.
    local lost=0
    for p in "${wanted[@]}"; do
      ref="$(path_ref "${p}")"
      cur="$(ref_oid "${ref}")"
      [[ -z "${cur}" || "${cur}" == "${new_oid}" ]] && continue
      describe "${cur}"
      [[ "${D_JOB}" == "${job}" ]] && continue
      refusal "${p}"
      lost=1
    done
    if ((lost == 0)); then
      if ((TEXT)); then
        printf 'git-locks: refused — transaction failed: %s\n' "${err}" >&2
      else
        json_str _j1 "${err}"
        printf '{"event":"refused","reason":"transaction","detail":%s}\n' "${_j1}" >&2
      fi
    fi
    exit 1
  fi

  if ((TEXT)); then
    printf '%s\n' "${record}"
  else
    local jpaths
    json_paths jpaths < <(printf '%s\n' "${wanted[@]}")
    json_str _j1 "${job}"
    json_str _j2 "${holder}"
    printf '{"event":"claimed","job":%s,"holder":%s,"claimed":%s,"expires":%s,"paths":%s}\n' \
      "${_j1}" "${_j2}" "${at}" "${expires}" "${jpaths}"
  fi
}

refusal() { # path, after describe(): one refusal line on stderr
  local _j1 _j2 _j3
  if ((TEXT)); then
    printf 'git-locks: refused — %s: held by %s (job %s, until %s)\n' "$1" "${D_HOLDER}" "${D_JOB}" "${D_UNTIL}" >&2
  else
    json_str _j1 "$1"
    json_str _j2 "${D_HOLDER}"
    json_str _j3 "${D_JOB}"
    printf '{"event":"refused","path":%s,"holder":%s,"job":%s,"expires":%s}\n' \
      "${_j1}" "${_j2}" "${_j3}" "${D_EXPIRES}" >&2
  fi
}

# ---------------------------------------------------------------- release

cmd_release() {
  local _j1 _j2 _j3
  local job=''
  while (($# > 0)); do
    case "$1" in
      --job)
        [[ $# -ge 2 ]] || usage
        job="$2"
        shift 2
        ;;
      *) usage ;;
    esac
  done
  [[ -n "${job}" ]] || usage
  valid_job "${job}" || fail "job id '${job}' must match [A-Za-z0-9][A-Za-z0-9._-]*" 2
  local jref oid
  jref="$(job_ref "${job}")"
  oid="$(ref_oid "${jref}")"
  if [[ -z "${oid}" ]]; then
    if ((TEXT)); then
      printf 'no lock to release for job %s\n' "${job}"
    else
      json_str _j1 "${job}"
      printf '{"event":"nothing","job":%s}\n' "${_j1}"
    fi
    return 0
  fi
  local plan=("delete ${jref} ${oid}") p ref have paths
  paths="$(record_paths "${oid}")"
  while IFS= read -r p; do
    [[ -z "${p}" ]] && continue
    ref="$(path_ref "${p}")"
    have="$(ref_oid "${ref}")"
    [[ "${have}" == "${oid}" ]] && plan+=("delete ${ref} ${oid}")
  done <<<"${paths}"
  printf '%s\n' "${plan[@]}" | transact >/dev/null 2>&1 || fail "could not release job ${job} (changed underneath; re-run)"
  if ((TEXT)); then
    printf 'released job %s (%d path(s))\n' "${job}" "$((${#plan[@]} - 1))"
  else
    json_str _j1 "${job}"
    printf '{"event":"released","job":%s,"paths":%d}\n' "${_j1}" "$((${#plan[@]} - 1))"
  fi
}

# ---------------------------------------------------------------- check

cmd_check() {
  local _j1 _j2 _j3
  (($# > 0)) || usage
  local at held=0 p n ref cur jp
  at="$(now)"
  for p in "$@"; do
    n="$(normalize_path "${p}")" || exit 2
    ref="$(path_ref "${n}")"
    cur="$(ref_oid "${ref}")"
    json_str _j1 "${n}"
    jp="${_j1}"
    if [[ -z "${cur}" ]]; then
      if ((TEXT)); then printf '%s: free\n' "${n}"; else printf '{"path":%s,"state":"free"}\n' "${jp}"; fi
      continue
    fi
    describe "${cur}"
    if [[ "${D_EXPIRES}" -gt "${at}" ]]; then
      if ((TEXT)); then
        printf '%s: held by %s (job %s, until %s)\n' "${n}" "${D_HOLDER}" "${D_JOB}" "${D_UNTIL}"
      else
        json_str _j1 "${D_HOLDER}"
        json_str _j2 "${D_JOB}"
        printf '{"path":%s,"state":"held","holder":%s,"job":%s,"expires":%s}\n' "${jp}" "${_j1}" "${_j2}" "${D_EXPIRES}"
      fi
      held=1
    else
      if ((TEXT)); then
        printf '%s: free (expired lock by %s, job %s, expired at %s)\n' "${n}" "${D_HOLDER}" "${D_JOB}" "${D_UNTIL}"
      else
        json_str _j1 "${D_HOLDER}"
        json_str _j2 "${D_JOB}"
        printf '{"path":%s,"state":"expired","holder":%s,"job":%s,"expires":%s}\n' "${jp}" "${_j1}" "${_j2}" "${D_EXPIRES}"
      fi
    fi
  done
  return "${held}"
}

# ---------------------------------------------------------------- list

cmd_list() {
  local _j1 _j2 _j3
  (($# == 0)) || usage
  local at any=0 line ref oid state rows paths
  at="$(now)"
  rows="$(job_refs)"
  while IFS=' ' read -r ref oid; do
    [[ -z "${ref}" ]] && continue
    any=1
    describe "${oid}"
    if [[ "${D_EXPIRES}" -gt "${at}" ]]; then state='live'; else state='expired'; fi
    paths="$(record_paths "${oid}")"
    if ((TEXT)); then
      printf '%-7s %s  job %s  until %s\n' "${state}" "${D_HOLDER}" "${D_JOB}" "${D_UNTIL}"
      while IFS= read -r line; do
        [[ -n "${line}" ]] && printf '        %s\n' "${line}"
      done <<<"${paths}"
    else
      local claimed jpaths
      claimed="$(field "${oid}" claimed)"
      json_paths jpaths <<<"${paths}"
      json_str _j1 "${D_JOB}"
      json_str _j2 "${D_HOLDER}"
      printf '{"job":%s,"holder":%s,"state":"%s","claimed":%s,"expires":%s,"paths":%s}\n' \
        "${_j1}" "${_j2}" "${state}" "${claimed:-0}" "${D_EXPIRES}" "${jpaths}"
    fi
  done <<<"${rows}"
  ((any || TEXT == 0)) || printf 'no locks\n'
  return 0
}

# ---------------------------------------------------------------- sweep

cmd_sweep() {
  local _j1 _j2 _j3
  (($# == 0)) || usage
  local at ref oid p pref plan rows paths have
  at="$(now)"
  rows="$(job_refs)"
  while IFS=' ' read -r ref oid; do
    [[ -z "${ref}" ]] && continue
    describe "${oid}"
    [[ "${D_EXPIRES}" -gt "${at}" ]] && continue
    plan=("delete ${ref} ${oid}")
    paths="$(record_paths "${oid}")"
    while IFS= read -r p; do
      [[ -z "${p}" ]] && continue
      pref="$(path_ref "${p}")"
      have="$(ref_oid "${pref}")"
      [[ "${have}" == "${oid}" ]] && plan+=("delete ${pref} ${oid}")
    done <<<"${paths}"
    if printf '%s\n' "${plan[@]}" | transact >/dev/null 2>&1; then
      if ((TEXT)); then
        printf 'swept job %s (holder %s, expired at %s)\n' "${D_JOB}" "${D_HOLDER}" "${D_UNTIL}"
      else
        json_str _j1 "${D_JOB}"
        json_str _j2 "${D_HOLDER}"
        printf '{"event":"swept","job":%s,"holder":%s,"expires":%s}\n' "${_j1}" "${_j2}" "${D_EXPIRES}"
      fi
    else
      if ((TEXT)); then
        printf 'skipped job %s: changed underneath\n' "${D_JOB}" >&2
      else
        json_str _j1 "${D_JOB}"
        printf '{"event":"skipped","job":%s,"reason":"changed underneath"}\n' "${_j1}" >&2
      fi
    fi
  done <<<"${rows}"
  return 0
}

# ---------------------------------------------------------------- store

cmd_schema() { # the public output schema, byte-identical to schema/git-locks.schema.json in the repository
  (($# == 0)) || usage
  cat <<'EOF'
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/git-stunts/locks/main/schema/git-locks.schema.json",
  "title": "git-locks output",
  "description": "Every line git-locks writes to stdout or stderr in its default mode is one JSON object matching exactly one of the definitions below. Lines are emitted as each result is known (JSON Lines); nothing is buffered into an array. `git locks schema` prints this document.",
  "oneOf": [
    { "$ref": "#/$defs/check_line" },
    { "$ref": "#/$defs/list_line" },
    { "$ref": "#/$defs/claim_line" },
    { "$ref": "#/$defs/refusal_line" },
    { "$ref": "#/$defs/release_line" },
    { "$ref": "#/$defs/sweep_line" },
    { "$ref": "#/$defs/store_line" },
    { "$ref": "#/$defs/version_line" }
  ],
  "$defs": {
    "job": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "The job id, as given to --job. Names the lock: refs/locks/jobs/<job>."
    },
    "holder": {
      "type": "string",
      "minLength": 1,
      "description": "Whoever claimed, as given to --holder. Free text, one line."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative path, normalised: no leading ./, never absolute, never containing a .. component or a newline."
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds since the Unix epoch, UTC."
    },
    "check_line": {
      "type": "object",
      "description": "One line per path from `git locks check`, in argument order, as each is examined.",
      "required": ["path", "state"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "state": { "enum": ["free", "held", "expired"] },
        "holder": { "$ref": "#/$defs/holder" },
        "job": { "$ref": "#/$defs/job" },
        "expires": { "$ref": "#/$defs/epoch" }
      },
      "additionalProperties": false,
      "if": { "properties": { "state": { "const": "free" } } },
      "then": { "required": ["path", "state"], "not": { "anyOf": [{ "required": ["holder"] }, { "required": ["job"] }, { "required": ["expires"] }] } },
      "else": { "required": ["path", "state", "holder", "job", "expires"] }
    },
    "list_line": {
      "type": "object",
      "description": "One line per lock from `git locks list`, live or expired, in ref order.",
      "required": ["job", "holder", "state", "claimed", "expires", "paths"],
      "properties": {
        "job": { "$ref": "#/$defs/job" },
        "holder": { "$ref": "#/$defs/holder" },
        "state": { "enum": ["live", "expired"] },
        "claimed": { "$ref": "#/$defs/epoch" },
        "expires": { "$ref": "#/$defs/epoch" },
        "paths": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "claim_line": {
      "type": "object",
      "description": "The single stdout line of a successful `git locks claim`.",
      "required": ["event", "job", "holder", "claimed", "expires", "paths"],
      "properties": {
        "event": { "const": "claimed" },
        "job": { "$ref": "#/$defs/job" },
        "holder": { "$ref": "#/$defs/holder" },
        "claimed": { "$ref": "#/$defs/epoch" },
        "expires": { "$ref": "#/$defs/epoch" },
        "paths": { "type": "array", "items": { "$ref": "#/$defs/path" }, "minItems": 1, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "refusal_line": {
      "type": "object",
      "description": "On stderr, one line per held path when a claim is refused (exit 1); or a single transaction failure with git's message.",
      "oneOf": [
        {
          "required": ["event", "path", "holder", "job", "expires"],
          "properties": {
            "event": { "const": "refused" },
            "path": { "$ref": "#/$defs/path" },
            "holder": { "$ref": "#/$defs/holder" },
            "job": { "$ref": "#/$defs/job" },
            "expires": { "$ref": "#/$defs/epoch" }
          },
          "additionalProperties": false
        },
        {
          "required": ["event", "reason", "detail"],
          "properties": {
            "event": { "const": "refused" },
            "reason": { "const": "transaction" },
            "detail": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "release_line": {
      "type": "object",
      "description": "The single stdout line of `git locks release`: what was released, or that there was nothing to release.",
      "oneOf": [
        {
          "required": ["event", "job", "paths"],
          "properties": {
            "event": { "const": "released" },
            "job": { "$ref": "#/$defs/job" },
            "paths": { "type": "integer", "minimum": 0, "description": "How many path refs were deleted with the job ref." }
          },
          "additionalProperties": false
        },
        {
          "required": ["event", "job"],
          "properties": {
            "event": { "const": "nothing" },
            "job": { "$ref": "#/$defs/job" }
          },
          "additionalProperties": false
        }
      ]
    },
    "sweep_line": {
      "type": "object",
      "description": "One stdout line per expired lock `git locks sweep` deleted; on stderr, one per lock it could not delete because it changed underneath.",
      "oneOf": [
        {
          "required": ["event", "job", "holder", "expires"],
          "properties": {
            "event": { "const": "swept" },
            "job": { "$ref": "#/$defs/job" },
            "holder": { "$ref": "#/$defs/holder" },
            "expires": { "$ref": "#/$defs/epoch" }
          },
          "additionalProperties": false
        },
        {
          "required": ["event", "job", "reason"],
          "properties": {
            "event": { "const": "skipped" },
            "job": { "$ref": "#/$defs/job" },
            "reason": { "const": "changed underneath" }
          },
          "additionalProperties": false
        }
      ]
    },
    "store_line": {
      "type": "object",
      "description": "The single line of `git locks store`: the absolute path of the store this repository resolves to.",
      "required": ["store"],
      "properties": { "store": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "version_line": {
      "type": "object",
      "description": "The single line of `git locks version`.",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "git-locks" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    }
  }
}
EOF
}

cmd_store() {
  local _j1 _j2 _j3
  (($# == 0)) || usage
  json_str _j1 "${STORE}"
  if ((TEXT)); then printf '%s\n' "${STORE}"; else printf '{"store":%s}\n' "${_j1}"; fi
}

# ---------------------------------------------------------------- main

main() {
  if [[ "${1:-}" == '--text' ]]; then
    TEXT=1
    shift
  fi
  (($# > 0)) || usage
  local cmd="$1" a
  shift
  case "${cmd}" in
    help | --help | -h)
      usage_text
      exit 0
      ;;
    schema)
      cmd_schema "$@"
      exit 0
      ;;
    version | --version)
      if ((TEXT)); then printf 'git-locks %s\n' "${VERSION}"; else printf '{"name":"git-locks","version":"%s"}\n' "${VERSION}"; fi
      exit 0
      ;;
    claim | release | check | list | sweep | store) ;;
    *) usage ;;
  esac
  for a in "$@"; do
    if [[ "${a}" == '--help' || "${a}" == '-h' ]]; then
      sub_usage "${cmd}"
      exit 0
    fi
  done
  require_repo
  resolve_store
  "cmd_${cmd}" "$@"
}

main "$@"
